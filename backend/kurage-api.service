[Unit]
Description=Kurage FastAPI
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kojima/work/kurage/backend
Environment=KURAGE_PORT=18303
Environment=OLLAMA_URL=http://192.168.0.14:11434
Environment=OLLAMA_MODEL=gemma4:12b-it-qat
Environment=ERNIE_URL=http://192.168.0.11:8010/image/generate
Environment=PATH=/home/kojima/.nvm/versions/node/v20.20.2/bin:/home/kojima/.cargo/bin:/home/kojima/.local/bin:/home/kojima/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CODEX_IMAGE_BIN=/home/kojima/.nvm/versions/node/v20.20.2/bin/codex
Environment=CODEX_IMAGE_TIMEOUT=600
Environment=CODEX_IMAGE_FALLBACK=ernie
Environment=CODEX_IMAGE_COOLDOWN=1800
Environment=WAN_API=http://192.168.0.14:8091
Environment=WAN_TEST_MODE=0
Environment=KURAGE_TTS_BACKEND=voicebox
Environment=VOICEBOX_API=http://192.168.0.11:17493
Environment=VOICEBOX_PROFILE_ID=1fe9e00c-cc81-4b07-8884-24acf639ef5e
Environment=VOICEBOX_ENGINE=qwen
Environment=VOICEBOX_GENERATION_TIMEOUT=900
Environment=VOICEBOX_RETRY_ATTEMPTS=3
Environment=VOICEBOX_USE_RQDB4AI=1
Environment=VOICEBOX_RQDB4AI_QUEUE_CLASS=web
ExecStart=/home/kojima/work/kurage/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 18303
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
